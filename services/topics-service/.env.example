# ── Service ───────────────────────────────────────────────────────────────────
SERVICE_NAME=topics-service
SERVICE_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=2
REQUEST_TIMEOUT=30
GRACEFUL_SHUTDOWN_TIMEOUT=10

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres          # service name in docker-compose
POSTGRES_PORT=5432
POSTGRES_DB=topics_db
POSTGRES_USER=topics_user
POSTGRES_PASSWORD=change_me_in_production

# Connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── JWT (shared with auth-service) ────────────────────────────────────────────
JWT_SECRET_KEY=change_me_in_production_use_a_strong_secret
JWT_ALGORITHM=HS256
# Optional — leave empty to skip validation
JWT_AUDIENCE=
JWT_ISSUER=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list or JSON array. Use ["*"] for open access (dev only)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
